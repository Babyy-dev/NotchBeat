<Window x:Class="NotchBeat.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NotchBeat"
        Title="NotchBeat"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        UseLayoutRounding="True"
        Width="420"
        Height="340">

    <Window.Resources>
        <!-- A round, see-through button showing one icon-font character. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Highlight" Width="34" Height="28" CornerRadius="14" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Highlight" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Highlight" Property="Background" Value="#38FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- Positioned by IslandWindow.ApplyLayout; sized every frame. -->
        <Grid x:Name="IslandHost" VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0">
            <Grid.Effect>
                <DropShadowEffect x:Name="Shadow" BlurRadius="24" ShadowDepth="0" Color="Black" Opacity="0" />
            </Grid.Effect>

            <!-- Everything inside is clipped to the notch shape. -->
            <Grid x:Name="Island">

                <!-- Background, depending on the theme. -->
                <Rectangle x:Name="SolidBackground" Fill="Black" />
                <Rectangle x:Name="GlassBackground" Opacity="0" />
                <Grid x:Name="ArtworkBackground" Opacity="0" ClipToBounds="True">
                    <Image x:Name="BlurredArtwork" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                        <!-- Scaled up so the blur's soft edges stay hidden. -->
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="1.4" ScaleY="1.4" />
                        </Image.RenderTransform>
                        <Image.Effect>
                            <BlurEffect x:Name="ArtworkBlur" KernelType="Gaussian" />
                        </Image.Effect>
                    </Image>
                    <Rectangle x:Name="ArtworkDimming" Fill="Black" />
                </Grid>
                <Rectangle x:Name="AccentTint" Opacity="0" />
                <!-- Keeps the top black so the island looks attached to the screen edge. -->
                <Rectangle x:Name="TopFade" Opacity="0">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,0.35">
                            <GradientStop Color="Black" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Compact: artwork | title | waves -->
                <Grid x:Name="CompactPanel" VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <local:SpinningArtwork x:Name="CompactArtwork" Grid.Column="0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <local:MarqueeText x:Name="CompactTitle" Grid.Column="1" VerticalAlignment="Center" />
                    <local:WaveView x:Name="CompactWaves" Grid.Column="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- Peek: shown briefly when the song changes. -->
                <Grid x:Name="PeekPanel" VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0">
                    <DockPanel x:Name="PeekContent" Margin="24,0" VerticalAlignment="Top">
                        <local:SpinningArtwork x:Name="PeekArtwork" DockPanel.Dock="Left" VerticalAlignment="Center" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PeekTitle" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="PeekArtist" Foreground="#99FFFFFF" FontSize="11" Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </Grid>

                <!-- Activity: volume, audio device, charging. -->
                <Grid x:Name="ActivityPanel" VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0">
                    <DockPanel x:Name="ActivityContent" Margin="24,0" Height="26" VerticalAlignment="Top">
                        <TextBlock x:Name="ActivityIcon" DockPanel.Dock="Left" Style="{StaticResource Glyph}"
                                   Width="26" FontSize="16" Foreground="White" TextAlignment="Center" />
                        <Grid x:Name="ActivityLevel" DockPanel.Dock="Right" Width="90" Height="5" Margin="8,0,0,0">
                            <Border Background="#33FFFFFF" CornerRadius="2.5" />
                            <Border x:Name="ActivityLevelFill" Background="White" CornerRadius="2.5"
                                    HorizontalAlignment="Left" />
                        </Grid>
                        <TextBlock x:Name="ActivityTitle" Margin="10,0,0,0" Foreground="White" FontSize="12"
                                   FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Grid>

                <!-- Expanded: the full player, styled after Samsung's Now Bar. -->
                <Grid x:Name="ExpandedPanel" VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0"
                      RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ExpandedScale" />
                    </Grid.RenderTransform>

                    <local:WaveView x:Name="BottomWaves" VerticalAlignment="Bottom" />

                    <StackPanel x:Name="ExpandedContent" Margin="22,0" VerticalAlignment="Top">
                        <DockPanel>
                            <local:SpinningArtwork x:Name="ExpandedArtwork" DockPanel.Dock="Left" Margin="0,0,14,0"
                                                   VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <local:MarqueeText x:Name="ExpandedTitle" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                    <Button x:Name="PreviousButton" Style="{StaticResource IconButton}" FontSize="15" />
                                    <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" FontSize="20"
                                            Margin="26,0" />
                                    <Button x:Name="NextButton" Style="{StaticResource IconButton}" FontSize="15" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <!-- The current lyric line. Click for full karaoke lyrics. -->
                        <Grid x:Name="LyricLineRow" Height="18" Margin="0,8,0,0" Background="Transparent"
                              Cursor="Hand" ClipToBounds="True">
                            <TextBlock x:Name="LyricLine" FontSize="12" FontWeight="Medium" Margin="0,0,18,0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="LyricLineShift" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock x:Name="LyricsIcon" Style="{StaticResource Glyph}" HorizontalAlignment="Right"
                                       FontSize="11" Foreground="#80FFFFFF" />
                        </Grid>

                        <local:ProgressRow x:Name="Progress" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Lyrics: full karaoke view. Click the header to go back. -->
                <Grid x:Name="LyricsPanel" VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0">
                    <DockPanel x:Name="LyricsContent" Margin="24,0,24,14">
                        <DockPanel x:Name="LyricsHeader" DockPanel.Dock="Top" Background="Transparent" Cursor="Hand">
                            <local:SpinningArtwork x:Name="LyricsArtwork" DockPanel.Dock="Left" Margin="0,0,10,0"
                                                   VerticalAlignment="Center" />
                            <TextBlock x:Name="LyricsCloseIcon" DockPanel.Dock="Right" Style="{StaticResource Glyph}"
                                       Margin="10,0,0,0" FontSize="12" Foreground="#99FFFFFF" />
                            <local:MarqueeText x:Name="LyricsTitle" VerticalAlignment="Center" />
                        </DockPanel>
                        <local:LyricsList x:Name="LyricsLines" Margin="0,10,0,0" />
                    </DockPanel>
                </Grid>
            </Grid>

            <!-- Neon glow or glass edge, drawn outside the clip so the whole stroke shows. -->
            <Path x:Name="Outline" IsHitTestVisible="False" Opacity="0">
                <Path.Effect>
                    <DropShadowEffect x:Name="OutlineGlow" ShadowDepth="0" BlurRadius="12" Opacity="0" />
                </Path.Effect>
            </Path>
        </Grid>
    </Grid>
</Window>
